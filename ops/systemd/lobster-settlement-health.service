[Unit]
Description=Settlement health audit for all sports sites
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/settlement_health_check.py
TimeoutSec=180
Nice=8
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=append:/var/log/settlement_health_check.log
StandardError=append:/var/log/settlement_health_check.log
