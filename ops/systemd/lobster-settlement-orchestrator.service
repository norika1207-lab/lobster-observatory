[Unit]
Description=Cross-site sports schedule and settlement orchestrator
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/settlement_orchestrator.py
TimeoutSec=900
Nice=8
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=append:/var/log/settlement_orchestrator.log
StandardError=append:/var/log/settlement_orchestrator.log
