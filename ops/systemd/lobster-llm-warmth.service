[Unit]
Description=Lobster local-LLM warmth monitor (keeps qwen2.5:14b resident on laptop via tunnel 18044)
After=network-online.target

[Service]
Environment=LOBSTER_LLM_WARM_MODEL=lobster-zh-chat-v2:latest
Type=oneshot
ExecStart=/usr/bin/python3 /opt/battle_arena/ops/lobster-llm-warmth.py
# Tunables (defaults are baked into the script; override here if the topology changes)
# Environment=LOBSTER_LLM_WARM_URL=http://127.0.0.1:18044
# Environment=LOBSTER_LLM_WARM_MODEL=qwen2.5:14b
# Environment=LOBSTER_LLM_REWARM_MARGIN_MIN=90
