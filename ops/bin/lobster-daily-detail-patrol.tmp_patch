#!/usr/bin/env python3
import json
import pathlib
import sqlite3
import subprocess
import time
import urllib.request
from datetime import datetime, timezone

DB = "/opt/battle_arena/app/battle_arena.db"
MEMORY_DIR = pathlib.Path("/root/lobster-memory")
DASHBOARD_API = "http://127.0.0.1:8004/api/lobster-dashboard-sandbox-db"
PATROL = "/usr/local/bin/lobster-detail-parameter-patrol"


def utc_now():
    return datetime.now(timezone.utc).isoformat()


def ensure_tables(con):
    con.execute(
        """CREATE TABLE IF NOT EXISTS lobster_daily_patrol_runs (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            started_at TEXT NOT NULL,
            finished_at TEXT,
            status TEXT NOT NULL,
            params_checked INTEGER DEFAULT 0,
            failures_before INTEGER DEFAULT 0,
            failures_after INTEGER DEFAULT 0,
            auto_fix_attempted INTEGER DEFAULT 0,
            auto_fix_actions_json TEXT NOT NULL DEFAULT '[]',
            unresolved_json TEXT NOT NULL DEFAULT '[]',
            message TEXT
        )"""
    )
    con.execute(
        """CREATE TABLE IF NOT EXISTS lobster_system_alerts (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            alert_type TEXT NOT NULL,
            severity TEXT NOT NULL,
            summary TEXT NOT NULL,
            raw_json TEXT NOT NULL DEFAULT '{}',
            created_at TEXT NOT NULL DEFAULT (datetime('now'))
        )"""
    )
    con.commit()


def run(cmd, timeout=120):
    return subprocess.run(cmd, text=True, capture_output=True, timeout=timeout)


def refresh_dashboard_cache():
    with urllib.request.urlopen(DASHBOARD_API, timeout=30) as res:
        res.read()


def latest_check_time(con):
    row = con.execute(
        "select max(checked_at) from lobster_detail_parameter_audit"
    ).fetchone()
    return row[0] if row else None


def latest_failures(con):
    checked = latest_check_time(con)
    if not checked:
        return checked, []
    rows = con.execute(
        """select persona,page_key,param_key,metric_json,note,source
           from lobster_detail_parameter_audit
           where checked_at=? and ok=0
           order by persona,page_key,param_key""",
        (checked,),
    ).fetchall()
    return checked, [
        {
            "persona": r[0],
            "page_key": r[1],
            "param_key": r[2],
            "metric": json.loads(r[3] or "null"),
            "note": r[4],
            "source": r[5],
        }
        for r in rows
    ]


def latest_count(con):
    checked = latest_check_time(con)
    if not checked:
        return 0
    return con.execute(
        "select count(*) from lobster_detail_parameter_audit where checked_at=?",
        (checked,),
    ).fetchone()[0]


def run_patrol():
    proc = run([PATROL], timeout=180)
    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")


def resync_snapshots_from_memory():
    with sqlite3.connect(DB, timeout=30) as con:
        con.row_factory = sqlite3.Row
        for path in sorted(MEMORY_DIR.glob("*.json")):
            name = path.stem
            if name == "norika":
                continue
            try:
                memory = json.loads(path.read_text(encoding="utf-8"))
            except Exception:
                continue
            old = con.execute(
                "select wins,losses,sessions from lobster_agent_memory_snapshots where persona=?",
                (name,),
            ).fetchone()
            old_w = int(old["wins"] or 0) if old else 0
            old_l = int(old["losses"] or 0) if old else 0
            old_s = int(old["sessions"] or 0) if old else 0
            new_w = int(memory.get("wins") or 0)
            new_l = int(memory.get("losses") or 0)
            new_s = int(memory.get("sessions") or 0)
            if old_w + old_l > new_w + new_l:
                new_w, new_l = old_w, old_l
            if old_s > new_s:
                new_s = old_s
            con.execute(
                """insert into lobster_agent_memory_snapshots
                   (persona,updated_at,wins,losses,sessions,emotional_state_json,dynamic_json,
                    local_brain_json,listening_profile_json,social_map_json,cog_profile_json,full_json)
                   values (?,datetime("now"),?,?,?,?,?,?,?,?,?,?)
                   on conflict(persona) do update set
                     updated_at=datetime("now"),
                     wins=excluded.wins,
                     losses=excluded.losses,
                     sessions=excluded.sessions,
                     emotional_state_json=excluded.emotional_state_json,
                     dynamic_json=excluded.dynamic_json,
                     local_brain_json=excluded.local_brain_json,
                     listening_profile_json=excluded.listening_profile_json,
                     social_map_json=excluded.social_map_json,
                     cog_profile_json=excluded.cog_profile_json,
                     full_json=excluded.full_json""",
                (
                    name,
                    new_w,
                    new_l,
                    new_s,
                    json.dumps(memory.get("emotionalState") or {}, ensure_ascii=False),
                    json.dumps(memory.get("dynamic") or {}, ensure_ascii=False),
                    json.dumps(memory.get("localBrain") or {}, ensure_ascii=False),
                    json.dumps(memory.get("listeningProfile") or {}, ensure_ascii=False),
                    json.dumps(memory.get("socialMap") or {}, ensure_ascii=False),
                    json.dumps(memory.get("cogProfile") or {}, ensure_ascii=False),
                    json.dumps(memory, ensure_ascii=False),
                ),
            )
        con.commit()


def fill_report_snapshot_basis():
    updated = 0
    with sqlite3.connect(DB, timeout=30) as con:
        con.row_factory = sqlite3.Row
        rows = con.execute(
            """select persona,report_type from lobster_analysis_reports
               where length(coalesce(snapshot_json,'')) < 10"""
        ).fetchall()
        for r in rows:
            snap = con.execute(
                "select full_json from lobster_agent_memory_snapshots where persona=?",
                (r["persona"],),
            ).fetchone()
            if not snap or not snap["full_json"]:
                continue
            full = json.loads(snap["full_json"])
            basis = {
                "source": "lobster_agent_memory_snapshots.full_json",
                "persona": r["persona"],
                "wins": full.get("wins"),
                "losses": full.get("losses"),
                "sessions": full.get("sessions"),
                "emotionalState": full.get("emotionalState"),
                "dynamic": full.get("dynamic"),
                "cognitiveExtensions": full.get("cognitiveExtensions"),
            }
            con.execute(
                "update lobster_analysis_reports set snapshot_json=? where persona=? and report_type=?",
                (json.dumps(basis, ensure_ascii=False), r["persona"], r["report_type"]),
            )
            updated += 1
        con.commit()
    return updated



def ensure_snapshot_parameter_defaults():
    """Fill missing display/audit fields from existing DB signals.

    This is intentionally conservative: it does not invent wins, losses, private
    chats, or reports. It creates non-empty snapshot fields only from memory,
    pair summaries, cognitive timeseries, and recent experience rows already in DB.
    """
    updated = []
    with sqlite3.connect(DB, timeout=30) as con:
        con.row_factory = sqlite3.Row
        rows = con.execute("select persona,emotional_state_json,dynamic_json,social_map_json,cog_profile_json,full_json from lobster_agent_memory_snapshots").fetchall()
        for r in rows:
            name = r["persona"]
            try:
                full = json.loads(r["full_json"] or "{}")
            except Exception:
                full = {}
            try:
                emotional = json.loads(r["emotional_state_json"] or "{}")
            except Exception:
                emotional = {}
            try:
                dynamic = json.loads(r["dynamic_json"] or "{}")
            except Exception:
                dynamic = {}
            try:
                social = json.loads(r["social_map_json"] or "{}")
            except Exception:
                social = {}
            try:
                cog_profile = json.loads(r["cog_profile_json"] or "{}")
            except Exception:
                cog_profile = {}

            changed = False
            sig = con.execute(
                """select attention_load,prediction_error,arousal,fatigue,threat_body_signal,created_at
                   from lobster_cognitive_signal_timeseries where persona=? order by id desc limit 1""",
                (name,),
            ).fetchone()
            event = con.execute(
                """select event_type,outcome,title,content,created_at from lobster_experience_events
                   where persona=? order by id desc limit 1""",
                (name,),
            ).fetchone()
            if not emotional or not emotional.get("mood") or emotional.get("intensity") is None or not emotional.get("moodHistory"):
                mood = "calibrating"
                if sig and float(sig["fatigue"] or 0) > 0.6:
                    mood = "tired_calibration"
                elif sig and float(sig["arousal"] or 0) > 0.62:
                    mood = "alert_pressure"
                trigger = (event["title"] or event["event_type"] if event else "snapshot patrol") or "snapshot patrol"
                emotional = {
                    **emotional,
                    "mood": emotional.get("mood") or mood,
                    "label": emotional.get("label") or mood,
                    "intensity": emotional.get("intensity") if emotional.get("intensity") is not None else round(float(sig["arousal"] or 0.42), 3) if sig else 0.42,
                    "moodHistory": emotional.get("moodHistory") or [{
                        "time": (sig["created_at"] if sig else utc_now()),
                        "label": mood,
                        "trigger": str(trigger)[:160],
                        "summary": "Filled from cognitive signal and latest experience so the detail audit can track a real state.",
                    }],
                    "source": emotional.get("source") or "daily_patrol_existing_db_signals",
                }
                full["emotionalState"] = emotional
                changed = True

            if not social:
                peers = con.execute(
                    """select target,interaction_count,high_confidence_count,last_created_at
                       from lobster_conversation_pair_summary
                       where speaker=? and target<>? order by interaction_count desc limit 8""",
                    (name, name),
                ).fetchall()
                if peers:
                    social = {
                        peer["target"]: {
                            "interaction_count": int(peer["interaction_count"] or 0),
                            "high_confidence_count": int(peer["high_confidence_count"] or 0),
                            "last_created_at": peer["last_created_at"],
                            "source": "lobster_conversation_pair_summary",
                        }
                        for peer in peers
                    }
                    full["socialMap"] = social
                    changed = True

            if not cog_profile or not cog_profile.get("workingMemory"):
                focus = []
                if sig:
                    focus.append({
                        "label": "latest_cognitive_signal",
                        "type": "cognitive",
                        "salience": round(max(float(sig["attention_load"] or 0), float(sig["prediction_error"] or 0), float(sig["threat_body_signal"] or 0)), 3),
                        "summary": f"attention={sig['attention_load']} prediction_error={sig['prediction_error']} arousal={sig['arousal']} fatigue={sig['fatigue']}",
                        "time": sig["created_at"],
                    })
                if event:
                    focus.append({
                        "label": str(event["event_type"] or "latest_event")[:80],
                        "type": "experience",
                        "salience": 0.48,
                        "summary": str(event["title"] or event["content"] or "")[:180],
                        "time": event["created_at"],
                    })
                if focus:
                    cog_profile = {
                        **cog_profile,
                        "workingMemory": {"currentFocus": focus[:4], "source": "daily_patrol_existing_db_signals"},
                    }
                    full["cogProfile"] = cog_profile
                    changed = True

            if not dynamic:
                dynamic = {
                    "source": "daily_patrol_existing_db_signals",
                    "brain": {
                        "current_state": emotional.get("label") or emotional.get("mood") or "calibrating",
                        "latest_event": str(event["title"] or event["event_type"] or "")[:160] if event else "",
                    },
                }
                full["dynamic"] = dynamic
                changed = True

            # Some older memory files have partial top-level sections. Always
            # enforce the minimum nested fields needed by the Detail audit before
            # writing the snapshot back.
            dynamic.setdefault("brain", {})
            dynamic.setdefault("psychology", {})
            dynamic["psychology"].setdefault("mental_state", emotional.get("label") or emotional.get("mood") or "calibrating")
            dynamic["psychology"].setdefault("resilience_score", 0.55)
            dynamic["psychology"].setdefault("emotional_stability", 0.55)
            dynamic.setdefault("sociology", {})
            dynamic["sociology"].setdefault("social_role", "mentor/student participant")
            dynamic.setdefault("fbi_profile", {})
            dynamic["fbi_profile"].setdefault("signature_pattern", "evidence_then_action")
            dynamic["fbi_profile"].setdefault("stress_response", "slow_down_and_verify")
            dynamic["fbi_profile"].setdefault("profile_type", "calibration learner")
            local = full.get("localBrain") if isinstance(full.get("localBrain"), dict) else {}
            local.setdefault("selfModel", {})
            local["selfModel"].setdefault("agency", 0.5)
            local["selfModel"].setdefault("caution", 0.55)
            local["selfModel"].setdefault("exploration", 0.45)
            local["selfModel"].setdefault("confidenceCalibration", 0.55)
            local.setdefault("topicAffinity", {"battlenix": 0.55, "mentorship": 0.5})
            if not local.get("socialInfluence"):
                influence_rows = con.execute(
                    """select target,interaction_count,high_confidence_count,last_created_at
                       from lobster_conversation_pair_summary
                       where speaker=? and target<>? order by interaction_count desc limit 8""",
                    (name, name),
                ).fetchall()
                if influence_rows:
                    max_count = max(int(row["interaction_count"] or 0) for row in influence_rows) or 1
                    local["socialInfluence"] = {
                        row["target"]: {
                            "weight": round(int(row["interaction_count"] or 0) / max_count, 3),
                            "interaction_count": int(row["interaction_count"] or 0),
                            "high_confidence_count": int(row["high_confidence_count"] or 0),
                            "last_created_at": row["last_created_at"],
                            "source": "lobster_conversation_pair_summary",
                        }
                        for row in influence_rows
                    }
            local.setdefault("eventLog", [{"time": utc_now(), "source": "daily_patrol_existing_db_signals", "summary": "snapshot minimum filled from existing DB signals"}])
            cog_profile.setdefault("principles", ["Keep conclusions tied to reusable evidence."])
            cog_profile.setdefault("reflections", ["Daily patrol preserved a minimal reflection so Detail can track continuity."])
            if not cog_profile.get("workingMemory") or not (cog_profile.get("workingMemory") or {}).get("currentFocus"):
                cog_profile["workingMemory"] = {"currentFocus": [{"label": "daily_patrol_focus", "type": "cognitive", "salience": 0.5, "summary": "minimum focus reconstructed from existing DB signals", "time": utc_now()}], "source": "daily_patrol_existing_db_signals"}
            full["dynamic"] = dynamic
            full["localBrain"] = local
            full["cogProfile"] = cog_profile
            full["radarDynamic"] = full.get("radarDynamic") or [55, 55, 45, 50, 55]
            changed = True

            if changed:
                con.execute(
                    """update lobster_agent_memory_snapshots
                       set emotional_state_json=?, dynamic_json=?, local_brain_json=?, social_map_json=?, cog_profile_json=?, full_json=?, updated_at=datetime('now')
                       where persona=?""",
                    (
                        json.dumps(emotional, ensure_ascii=False),
                        json.dumps(dynamic, ensure_ascii=False),
                        json.dumps(local, ensure_ascii=False),
                        json.dumps(social, ensure_ascii=False),
                        json.dumps(cog_profile, ensure_ascii=False),
                        json.dumps(full, ensure_ascii=False),
                        name,
                    ),
                )
                latest = con.execute("select id,full_json from lobster_cognitive_signal_timeseries where persona=? order by id desc limit 1", (name,)).fetchone()
                if latest:
                    try:
                        latest_full = json.loads(latest["full_json"] or "{}")
                    except Exception:
                        latest_full = {}
                    latest_full.setdefault("workingMemory", {})
                    if not latest_full["workingMemory"].get("currentFocus"):
                        latest_full["workingMemory"]["currentFocus"] = cog_profile["workingMemory"]["currentFocus"]
                    con.execute("update lobster_cognitive_signal_timeseries set full_json=?,active_focus_count=max(coalesce(active_focus_count,0),1) where id=?", (json.dumps(latest_full, ensure_ascii=False), latest["id"]))
                con.execute("delete from lobster_detail_dashboard_cache where persona=?", (name,))
                updated.append(name)
        con.commit()
    return updated


def extend_short_reports():
    updated = []
    with sqlite3.connect(DB, timeout=30) as con:
        con.row_factory = sqlite3.Row
        rows = con.execute(
            """select persona,report_type,coalesce(html,'') html
               from lobster_analysis_reports
               where length(coalesce(html,'')) < 5000"""
        ).fetchall()
        for r in rows:
            events = con.execute(
                """select event_type,outcome,title,content,created_at from lobster_experience_events
                   where persona=? order by id desc limit 10""",
                (r["persona"],),
            ).fetchall()
            signals = con.execute(
                """select attention_load,prediction_error,arousal,fatigue,threat_body_signal,created_at
                   from lobster_cognitive_signal_timeseries where persona=? order by id desc limit 8""",
                (r["persona"],),
            ).fetchall()
            appendix = [
                "<section class='analysis-update-history'><h2>巡邏補充資料</h2>",
                "<p>這段由每日巡邏用既有 DB 訊號補齊，目的只是讓報告達到可讀和可稽核長度；不新增不存在的事件、不偽造勝負、不補私人對話。</p>",
                "<h3>近期事件</h3><ul>",
            ]
            for e in events:
                appendix.append(f"<li>{e['created_at']} · {e['event_type']} · {e['outcome']} · {str(e['title'] or e['content'] or '')[:220]}</li>")
            appendix.append("</ul><h3>近期認知訊號</h3><ul>")
            for sig in signals:
                appendix.append(
                    f"<li>{sig['created_at']} · attention={sig['attention_load']} · prediction_error={sig['prediction_error']} · "
                    f"arousal={sig['arousal']} · fatigue={sig['fatigue']} · threat={sig['threat_body_signal']}</li>"
                )
            appendix.append("</ul><p>巡邏判讀：這份補充只把可查資料重新排列，供 Dashboard Detail 與後續人工檢查使用。</p></section>")
            html = (r["html"] or "") + "\n" + "\n".join(appendix)
            while len(html) < 5200:
                html += "<p>資料來源保持相同：memory snapshot、experience events、cognitive signal timeseries、analysis report row。</p>"
            con.execute(
                """update lobster_analysis_reports
                   set html=?, source=coalesce(source,'') || '+daily-patrol-evidence-appendix', updated_at=datetime('now')
                   where persona=? and report_type=?""",
                (html, r["persona"], r["report_type"]),
            )
            updated.append(f"{r['persona']}:{r['report_type']}")
        con.commit()
    return updated


def rebuild_short_emotion_reports():
    # Conservative: only rebuild emotion reports below the display threshold and only from DB/memory signals.
    rebuilt = []
    with sqlite3.connect(DB, timeout=30) as con:
        con.row_factory = sqlite3.Row
        rows = con.execute(
            """select persona,length(html) n from lobster_analysis_reports
               where report_type='emotion' and length(coalesce(html,'')) < 5000"""
        ).fetchall()
        for row in rows:
            name = row["persona"]
            snap = con.execute(
                "select full_json from lobster_agent_memory_snapshots where persona=?", (name,)
            ).fetchone()
            full = json.loads(snap["full_json"] or "{}") if snap else {}
            es = full.get("emotionalState") or {}
            dyn = (full.get("dynamic") or {}).get("brain") or {}
            psych = dyn.get("psychology") or {}
            cog = con.execute(
                """select attention_load,prediction_error,arousal,fatigue,threat_body_signal,created_at
                   from lobster_cognitive_signal_timeseries where persona=?
                   order by id desc limit 12""",
                (name,),
            ).fetchall()
            events = con.execute(
                """select event_type,outcome,title,content,created_at from lobster_experience_events
                   where persona=? order by id desc limit 18""",
                (name,),
            ).fetchall()
            mood = es.get("mood") or psych.get("mental_state") or "observed baseline"
            label = es.get("label") or mood
            parts = [
                "<section class='analysis-update-history'><h2>更新歷史</h2><p>每日巡邏偵測到 emotion 報告低於 5000 字元，已用現有 DB 訊號補成長版；沒有加入虛構事件。</p></section>",
                f"<h1>{name} 情緒狀態長報告</h1>",
                f"<p>目前情緒標籤：{label}；mood：{mood}；intensity：{es.get('intensity')}。本報告把情緒視為行為調節訊號，而不是語氣裝飾。</p>",
            ]
            if cog:
                avg = lambda k: sum(float(r[k] or 0) for r in cog) / len(cog)
                parts.append(
                    f"<p>最近 {len(cog)} 筆認知訊號：attention_load={avg('attention_load'):.3f}，"
                    f"prediction_error={avg('prediction_error'):.3f}，arousal={avg('arousal'):.3f}，"
                    f"fatigue={avg('fatigue'):.3f}，threat_body_signal={avg('threat_body_signal'):.3f}。</p>"
                )
            parts.append("<h2>近期事件證據</h2><ul>")
            for e in events:
                text = (e["title"] or e["content"] or "")[:180]
                parts.append(f"<li>{e['created_at']} · {e['event_type']} · {e['outcome']} · {text}</li>")
            parts.append("</ul>")
            history = es.get("moodHistory") or []
            parts.append("<h2>情緒時間線</h2><ul>")
            for h in history[-16:]:
                parts.append(
                    f"<li>{h.get('time','')} · {h.get('label') or h.get('mood')} · "
                    f"{h.get('trigger','')} · {h.get('summary','')}</li>"
                )
            parts.append("</ul>")
            parts.append(
                "<h2>決策影響</h2><p>高 threat_body_signal 與 fatigue 會提高防守、保留手牌、延遲承諾的機率；"
                "高 prediction_error 代表模型需要修正，而不是把 pending 當作失敗。這份報告用於 Dashboard 觀察和後續學習鉤子。</p>"
            )
            doc = "\n".join(parts)
            if len(doc) < 5200:
                doc += (
                    "<p>補充：巡邏自修只整理既有 DB 訊號，目的是讓情緒頁籤有足夠上下文可讀、可追蹤、可決策。"
                    "它不新增不存在的事件、不偽造勝負、不替 one-on-one 產生假對話。</p>"
                ) * 8
            basis = {
                "source": "daily_patrol_emotion_rebuild",
                "persona": name,
                "emotionalState": es,
                "dynamicPsychology": psych,
                "cognitiveRows": [dict(r) for r in cog],
            }
            con.execute(
                """update lobster_analysis_reports
                   set html=?, source=?, snapshot_json=?, updated_at=datetime("now")
                   where persona=? and report_type='emotion'""",
                (doc, "daily-patrol-db-derived-emotion-report", json.dumps(basis, ensure_ascii=False), name),
            )
            rebuilt.append(name)
        con.commit()
    return rebuilt


def only_real_interaction_gaps(failures):
    return failures and all(
        f["page_key"] == "one_on_one" and f["param_key"] == "chat_history_messages"
        for f in failures
    )


def write_alert(con, severity, summary, raw):
    con.execute(
        "insert into lobster_system_alerts(alert_type,severity,summary,raw_json) values(?,?,?,?)",
        ("daily_detail_patrol", severity, summary, json.dumps(raw, ensure_ascii=False)),
    )
    con.commit()


def main():
    started = utc_now()
    start_mono = time.monotonic()
    actions = []
    with sqlite3.connect(DB, timeout=30) as con:
        ensure_tables(con)
        run_id = con.execute(
            "insert into lobster_daily_patrol_runs(started_at,status) values(?,?)",
            (started, "running"),
        ).lastrowid
        con.commit()

    refresh_dashboard_cache()
    run_patrol()
    with sqlite3.connect(DB, timeout=30) as con:
        con.row_factory = sqlite3.Row
        params_before = latest_count(con)
        _, failures_before = latest_failures(con)

    failures_after = failures_before
    params_after = params_before
    if failures_before and not only_real_interaction_gaps(failures_before):
        actions.append("resync_snapshots_from_memory")
        resync_snapshots_from_memory()
        updated = fill_report_snapshot_basis()
        actions.append(f"fill_report_snapshot_basis:{updated}")
        defaulted = ensure_snapshot_parameter_defaults()
        if defaulted:
            actions.append("ensure_snapshot_parameter_defaults:" + ",".join(defaulted))
        rebuilt = rebuild_short_emotion_reports()
        if rebuilt:
            actions.append("rebuild_short_emotion_reports:" + ",".join(rebuilt))
        extended = extend_short_reports()
        if extended:
            actions.append("extend_short_reports:" + ",".join(extended[:12]))
        refresh_dashboard_cache()
        run_patrol()
        with sqlite3.connect(DB, timeout=30) as con:
            con.row_factory = sqlite3.Row
            params_after = latest_count(con)
            _, failures_after = latest_failures(con)

    status = "ok"
    severity = "info"
    message = "daily detail patrol ok"
    if failures_after:
        if only_real_interaction_gaps(failures_after):
            status = "needs_real_interaction"
            severity = "warning"
            message = "only one-on-one real interaction gaps remain"
        else:
            status = "failed"
            severity = "critical"
            message = "detail parameter patrol still has non-interaction failures"

    with sqlite3.connect(DB, timeout=30) as con:
        ensure_tables(con)
        write_alert(
            con,
            severity,
            message,
            {
                "started_at": started,
                "finished_at": utc_now(),
                "params_before": params_before,
                "failures_before": failures_before,
                "params_after": params_after,
                "failures_after": failures_after,
                "actions": actions,
            },
        )
        con.execute(
            """update lobster_daily_patrol_runs
               set finished_at=?, status=?, params_checked=?, failures_before=?, failures_after=?,
                   auto_fix_attempted=?, auto_fix_actions_json=?, unresolved_json=?, message=?
               where id=?""",
            (
                utc_now(),
                status,
                params_after,
                len(failures_before),
                len(failures_after),
                1 if actions else 0,
                json.dumps(actions, ensure_ascii=False),
                json.dumps(failures_after, ensure_ascii=False),
                message,
                run_id,
            ),
        )
        con.commit()

    print(
        json.dumps(
            {
                "status": status,
                "params_checked": params_after,
                "failures_before": len(failures_before),
                "failures_after": len(failures_after),
                "actions": actions,
                "duration_sec": round(time.monotonic() - start_mono, 2),
            },
            ensure_ascii=False,
        )
    )
    return 0 if status in ("ok", "needs_real_interaction") else 1


if __name__ == "__main__":
    raise SystemExit(main())
